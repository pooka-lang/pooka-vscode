{
  "name": "pooka",
  "displayName": "Pooka",
  "description": "🦌 Give Pooka a place in Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "pooka-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooka-lang/pooka-vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "pooka",
    "beam",
    "erlang",
    "syntax"
  ],
  "icon": "icons/pooka.png",
  "contributes": {
    "languages": [
      {
        "id": "pooka",
        "aliases": [
          "Pooka",
          "pooka"
        ],
        "extensions": [
          ".pooka",
          ".spec.pooka"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pooka-light.svg",
          "dark": "./icons/pooka-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pooka",
        "scopeName": "source.pooka",
        "path": "./syntaxes/pooka.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pooka",
      "properties": {
        "pooka.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Start pooka lsp in trusted workspaces. Reload the window after changing this setting."
        },
        "pooka.languageServer.path": {
          "type": "string",
          "default": "pooka",
          "scope": "application",
          "description": "Pooka compiler executable. Use an absolute path if pooka is unavailable on PATH. Reload the window after changing this setting."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/pooka-lang/pooka-vscode/issues"
  },
  "homepage": "https://pooka.run",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The Pooka compiler runs only in trusted workspaces.",
      "restrictedConfigurations": [
        "pooka.languageServer.enabled",
        "pooka.languageServer.path"
      ]
    }
  }
}
